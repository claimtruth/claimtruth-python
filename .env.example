# Copy to .env and fill in locally. Never commit .env.

# Contact email sent to polite API pools (Crossref, OpenAlex, Unpaywall).
CLAIMTRUTH_CONTACT_EMAIL=
# Where caches, traces and the local database live (default: .cache/).
CLAIMTRUTH_DATA_DIR=
# JSON map of model aliases: {"alias": {"model_id": ..., "family": ..., "max_tokens": ...}}
CLAIMTRUTH_MODEL_ALIASES=

# Provider keys, read by LiteLLM.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
